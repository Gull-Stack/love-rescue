# Capacitor iOS native project — generated by `npx cap add ios`, so ignore all
# files but keep directories traversable and re-include the hand-maintained
# config files (Info.plist, App.entitlements) that must ship with the repo.
frontend/ios/**
!frontend/ios/**/
!frontend/ios/App/App/Info.plist
!frontend/ios/App/App/App.entitlements

